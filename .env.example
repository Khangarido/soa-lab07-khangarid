# .env.example - Жишээ environment variable файл
# Бодит утгуудтай .env файл үүсгэж ашиглана
# АНХААР: .env файлыг GitHub-д push хийхгүй! (.gitignore-д нэмнэ)

# DigitalOcean Spaces
S3_ACCESS_KEY=your_spaces_access_key_here
S3_SECRET_KEY=your_spaces_secret_key_here
S3_BUCKET_NAME=your-bucket-name
S3_REGION=sgp1

# SOAP Service URL (Droplet-ийн IP эсвэл Private IP)
SOAP_SERVICE_URL=http://YOUR_SOAP_DROPLET_IP:8080/UserService
